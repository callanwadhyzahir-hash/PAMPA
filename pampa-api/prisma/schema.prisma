generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model address {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  city_id      String   @db.Uuid
  street       String   @db.VarChar(150)
  number       String?  @db.VarChar(20)
  floor        String?  @db.VarChar(20)
  apartment    String?  @db.VarChar(20)
  neighborhood String?  @db.VarChar(100)
  zip_code     String?  @db.VarChar(20)
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  observations String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  city         city     @relation(fields: [city_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_address_city")
  branch       branch[]
  client       client[]
}

model branch {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String      @db.Uuid
  address_id String      @db.Uuid
  name       String      @db.VarChar(150)
  code       String      @db.VarChar(20)
  email      String?     @db.VarChar(255)
  phone      String?     @db.VarChar(50)
  is_main    Boolean     @default(false)
  is_active  Boolean     @default(true)
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  updated_at DateTime    @default(now()) @db.Timestamptz(6)
  address    address     @relation(fields: [address_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_branch_address")
  company    company     @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_branch_company")
  sale       sale[]
  user       user[]
  warehouse  warehouse[]
  catalog    catalog[]

  @@unique([company_id, code], map: "uq_branch_code")
  @@unique([id, company_id], map: "uq_branch_id_company")
}

/// Public storefront settings — one per company. Disabled (is_enabled=false)
/// and unpublished by default; the company opts in explicitly. Scoped to a
/// single branch/warehouse (same composite-FK pattern as `sale`) so public
/// availability always reflects one concrete stock location, never an
/// ambiguous aggregate across warehouses.
model catalog {
  id                String          @id(map: "pk_catalog") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id        String          @db.Uuid
  branch_id         String          @db.Uuid
  warehouse_id      String          @db.Uuid
  slug              String          @unique(map: "uq_catalog_slug") @db.VarChar(60)
  display_name      String          @db.VarChar(150)
  description       String?
  logo_url          String?         @db.VarChar(500)
  logo_pathname     String?         @db.VarChar(500)
  whatsapp          String?         @db.VarChar(50)
  contact_email     String?         @db.VarChar(255)
  is_enabled        Boolean         @default(false)
  show_prices       Boolean         @default(true)
  show_availability Boolean         @default(true)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @default(now()) @db.Timestamptz(6)
  company           company         @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_company")
  branch            branch          @relation(fields: [branch_id, company_id], references: [id, company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_branch_company")
  warehouse         warehouse       @relation(fields: [warehouse_id, company_id], references: [id, company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_warehouse_company")
  catalog_order     catalog_order[]

  @@unique([company_id], map: "uq_catalog_company")
  @@unique([id, company_id], map: "uq_catalog_id_company")
}

/// Public-catalog purchase intent. NOT a Sale — no stock effect until the
/// merchant accepts it (see docs/erp-domain-implementation.md decisions).
/// Accepting creates exactly one linked DRAFT `sale` (sale_id is unique);
/// all payment/confirmation lifecycle after that point lives on `sale`,
/// never duplicated here.
model catalog_order {
  id                 String               @id(map: "pk_catalog_order") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id         String               @db.Uuid
  catalog_id         String               @db.Uuid
  order_number       BigInt               @default(autoincrement())
  status             String               @default("PENDING") @db.VarChar(20)
  customer_name      String               @db.VarChar(150)
  customer_phone     String               @db.VarChar(50)
  customer_email     String?              @db.VarChar(255)
  notes              String?
  subtotal           Decimal              @default(0) @db.Decimal(15, 2)
  total              Decimal              @default(0) @db.Decimal(15, 2)
  client_id          String?              @db.Uuid
  sale_id            String?              @db.Uuid
  accepted_at        DateTime?            @db.Timestamptz(6)
  rejected_at        DateTime?            @db.Timestamptz(6)
  cancelled_at       DateTime?            @db.Timestamptz(6)
  rejection_reason   String?
  requester_ip_hash  String?              @db.VarChar(64)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  catalog            catalog              @relation(fields: [catalog_id, company_id], references: [id, company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_order_catalog_company")
  company            company              @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_order_company")
  client             client?              @relation(fields: [client_id, company_id], references: [id, company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_order_client_company")
  sale               sale?                @relation(fields: [sale_id, company_id], references: [id, company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_order_sale_company")
  catalog_order_item catalog_order_item[]

  @@unique([id, company_id], map: "uq_catalog_order_id_company")
  @@unique([sale_id, company_id], map: "uq_catalog_order_sale_company")
  @@index([company_id, status, created_at], map: "idx_catalog_order_company_status_created")
  @@index([client_id], map: "idx_catalog_order_client")
}

/// Snapshot line item of a catalog_order — same snapshot philosophy as
/// sale_item (name/code/price frozen at submission time, re-validated
/// against live product data before the order is accepted).
model catalog_order_item {
  id              String           @id(map: "pk_catalog_order_item") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id      String           @db.Uuid
  order_id        String           @db.Uuid
  product_id      String           @db.Uuid
  variant_id      String?          @db.Uuid
  variant_label   String?          @db.VarChar(50)
  line_number     Int
  product_name    String           @db.VarChar(200)
  product_code    String           @db.VarChar(50)
  quantity        Decimal          @db.Decimal(15, 3)
  unit_price      Decimal          @db.Decimal(15, 2)
  subtotal        Decimal          @db.Decimal(15, 2)
  order           catalog_order    @relation(fields: [order_id, company_id], references: [id, company_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_catalog_order_item_order_company")
  product         product          @relation(fields: [product_id, company_id], references: [id, company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_order_item_product_company")
  product_variant product_variant? @relation(fields: [variant_id, company_id], references: [id, company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_order_item_variant_company")

  @@unique([order_id, line_number], map: "uq_catalog_order_item_line")
  @@index([product_id], map: "idx_catalog_order_item_product")
  @@index([variant_id], map: "idx_catalog_order_item_variant")
}

model city {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state_id    String    @db.Uuid
  name        String    @db.VarChar(150)
  postal_code String?   @db.VarChar(20)
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  address     address[]
  state       state     @relation(fields: [state_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_city_state")

  @@unique([state_id, name], map: "uq_city_state")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model client {
  id              String          @id(map: "pk_client") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id      String          @db.Uuid
  address_id      String?         @db.Uuid
  code            String          @db.VarChar(30)
  first_name      String?         @db.VarChar(100)
  last_name       String?         @db.VarChar(100)
  business_name   String?         @db.VarChar(200)
  tax_id          String?         @db.VarChar(30)
  email           String?         @db.VarChar(255)
  phone           String?         @db.VarChar(50)
  mobile          String?         @db.VarChar(50)
  is_company      Boolean         @default(false)
  credit_limit    Decimal         @default(0) @db.Decimal(15, 2)
  current_balance Decimal         @default(0) @db.Decimal(15, 2)
  notes           String?
  is_active       Boolean         @default(true)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)
  address         address?        @relation(fields: [address_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_client_address")
  company         company         @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_client_company")
  sale            sale[]
  catalog_order   catalog_order[]

  @@unique([company_id, code], map: "uq_client_company_code")
  @@unique([id, company_id], map: "uq_client_id_company")
  @@index([business_name], map: "idx_client_business_name")
  @@index([company_id], map: "idx_client_company")
  @@index([tax_id], map: "idx_client_tax_id")
}

model company {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_type_id          String                     @db.Uuid
  tax_condition_id         String                     @db.Uuid
  currency_id              String                     @db.Uuid
  name                     String                     @db.VarChar(200)
  legal_name               String?                    @db.VarChar(250)
  tax_id                   String                     @unique @db.VarChar(30)
  email                    String?                    @db.VarChar(255)
  phone                    String?                    @db.VarChar(50)
  website                  String?                    @db.VarChar(255)
  logo_url                 String?
  is_active                Boolean                    @default(true)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  branch                   branch[]
  client                   client[]
  currency                 currency                   @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_company_currency")
  tax_condition            tax_condition              @relation(fields: [tax_condition_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_company_tax_condition")
  company_type             company_type               @relation(fields: [company_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_company_type")
  mercadolibre_connection  mercadolibre_connection[]
  product                  product[]
  product_category         product_category[]
  role                     role[]
  sale                     sale[]
  user                     user[]
  warehouse                warehouse[]
  security_event           security_event[]
  company_ai_subscription  company_ai_subscription?
  ai_usage_ledger          ai_usage_ledger[]
  user_onboarding_progress user_onboarding_progress[]
  catalog                  catalog?
  catalog_order            catalog_order[]

  @@index([created_at], map: "idx_company_created")
}

model company_type {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String    @unique @db.VarChar(30)
  name        String    @db.VarChar(100)
  description String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  company     company[]
}

model country {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  iso_code   String   @unique @db.Char(2)
  name       String   @unique @db.VarChar(100)
  phone_code String?  @db.VarChar(10)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  state      state[]
}

model currency {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String    @unique @db.VarChar(3)
  name       String    @db.VarChar(100)
  symbol     String?   @db.VarChar(10)
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  company    company[]
}

model invoice {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id             String                   @db.Uuid
  sale_id                String                   @unique @db.Uuid
  internal_number        String                   @unique @db.VarChar(50)
  document_label         String                   @default("COMPROBANTE INTERNO — NO FISCAL") @db.VarChar(100)
  invoice_number         String?                  @db.VarChar(50)
  invoice_type           String?                  @db.VarChar(10)
  cae                    String?                  @db.VarChar(50)
  cae_expiration         DateTime?                @db.Date
  issued_at              DateTime?                @db.Timestamptz(6)
  status                 String                   @default("ISSUED") @db.VarChar(20)
  fiscal_status          String                   @default("NOT_REQUESTED") @db.VarChar(20)
  fiscal_provider        String                   @default("ARCA") @db.VarChar(10)
  point_of_sale          String?                  @db.VarChar(10)
  voucher_type_code      String?                  @db.VarChar(10)
  qr_data                String?
  arca_error_code        String?                  @db.VarChar(50)
  arca_error_message     String?
  fiscal_requested_at    DateTime?                @db.Timestamptz(6)
  fiscal_approved_at     DateTime?                @db.Timestamptz(6)
  company_snapshot       Json
  client_snapshot        Json?
  items_snapshot         Json
  totals_snapshot        Json
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  sale                   sale                     @relation(fields: [sale_id, company_id], references: [id, company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invoice_sale_company")
  invoice_fiscal_attempt invoice_fiscal_attempt[]

  @@unique([sale_id, company_id], map: "uq_invoice_sale_company")
  @@unique([id, company_id], map: "uq_invoice_id_company")
  @@unique([company_id, point_of_sale, voucher_type_code, invoice_number], map: "uq_invoice_fiscal_document")
  @@index([invoice_number], map: "idx_invoice_number")
  @@index([fiscal_status], map: "idx_invoice_fiscal_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model invoice_fiscal_attempt {
  id               String    @id(map: "pk_invoice_fiscal_attempt") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id       String    @db.Uuid
  invoice_id       String    @db.Uuid
  attempt_number   Int
  environment      String    @db.VarChar(20)
  status           String    @db.VarChar(20)
  request_payload  Json
  response_payload Json?
  error_code       String?   @db.VarChar(50)
  error_message    String?
  started_at       DateTime  @default(now()) @db.Timestamptz(6)
  finished_at      DateTime? @db.Timestamptz(6)
  invoice          invoice   @relation(fields: [invoice_id, company_id], references: [id, company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invoice_fiscal_attempt_invoice_company")

  @@unique([invoice_id, attempt_number], map: "uq_invoice_fiscal_attempt_number")
  @@index([company_id, started_at], map: "idx_invoice_fiscal_attempt_company_started")
}

/// Mercado Libre v1: one connection per company. Tokens are stored encrypted
/// (AES-256-GCM via MERCADOLIBRE_TOKEN_ENCRYPTION_KEY) and never selected
/// into API responses — see MercadoLibreConnectionRepository.
model mercadolibre_connection {
  id                      String                 @id(map: "pk_mercadolibre_connection") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id              String                 @db.Uuid
  /// 'REAL' | 'MOCK'. Set explicitly on every write (no DB default) so a
  /// connection can never end up mock/real by omission — mirrors
  /// invoice.fiscal_provider in the ARCA module.
  provider                String                 @db.VarChar(10)
  ml_user_id              String                 @db.VarChar(50)
  nickname                String                 @db.VarChar(100)
  site_id                 String                 @db.VarChar(10)
  access_token_encrypted  String?
  refresh_token_encrypted String?
  token_expires_at        DateTime?              @db.Timestamptz(6)
  scopes                  String?
  status                  String                 @default("DISCONNECTED") @db.VarChar(20)
  last_sync_at            DateTime?              @db.Timestamptz(6)
  last_error              String?
  created_at              DateTime               @default(now()) @db.Timestamptz(6)
  updated_at              DateTime               @default(now()) @db.Timestamptz(6)
  company                 company                @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mercadolibre_connection_company")
  mercadolibre_listing    mercadolibre_listing[]
  mercadolibre_order      mercadolibre_order[]

  @@unique([company_id], map: "uq_mercadolibre_connection_company")
  @@unique([id, company_id], map: "uq_mercadolibre_connection_id_company")
}

/// Local cache/snapshot of a Mercado Libre publicación. Linking to a PAMPA
/// product is a manual association only — v1 does not sync stock or price.
model mercadolibre_listing {
  id                        String                     @id(map: "pk_mercadolibre_listing") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id                String                     @db.Uuid
  connection_id             String                     @db.Uuid
  ml_item_id                String                     @db.VarChar(30)
  title                     String                     @db.VarChar(255)
  status                    String                     @db.VarChar(20)
  price                     Decimal                    @db.Decimal(15, 2)
  currency_id               String                     @db.VarChar(10)
  available_quantity        Int                        @default(0)
  sold_quantity             Int                        @default(0)
  thumbnail_url             String?
  permalink                 String?
  last_synced_at            DateTime                   @default(now()) @db.Timestamptz(6)
  created_at                DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                   @default(now()) @db.Timestamptz(6)
  connection                mercadolibre_connection    @relation(fields: [connection_id, company_id], references: [id, company_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mercadolibre_listing_connection_company")
  mercadolibre_product_link mercadolibre_product_link?

  @@unique([connection_id, ml_item_id], map: "uq_mercadolibre_listing_connection_item")
  @@unique([id, company_id], map: "uq_mercadolibre_listing_id_company")
  @@index([company_id], map: "idx_mercadolibre_listing_company")
}

/// Manual association listing <-> product. Composite FKs on both sides pin
/// listing and product to the same company_id, so a link can never cross
/// tenants even if application code passes a bad ID.
model mercadolibre_product_link {
  id         String               @id(map: "pk_mercadolibre_product_link") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String               @db.Uuid
  listing_id String               @db.Uuid
  product_id String               @db.Uuid
  created_at DateTime             @default(now()) @db.Timestamptz(6)
  updated_at DateTime             @default(now()) @db.Timestamptz(6)
  listing    mercadolibre_listing @relation(fields: [listing_id, company_id], references: [id, company_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mercadolibre_product_link_listing_company")
  product    product              @relation(fields: [product_id, company_id], references: [id, company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mercadolibre_product_link_product_company")

  @@unique([listing_id, company_id], map: "uq_mercadolibre_product_link_listing")
  @@unique([id, company_id], map: "uq_mercadolibre_product_link_id_company")
  @@index([company_id], map: "idx_mercadolibre_product_link_company")
  @@index([product_id], map: "idx_mercadolibre_product_link_product")
}

/// Local cache/snapshot of a Mercado Libre order. Minimizes buyer PII —
/// only an optional nickname, no address/email/phone.
model mercadolibre_order {
  id             String                  @id(map: "pk_mercadolibre_order") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id     String                  @db.Uuid
  connection_id  String                  @db.Uuid
  ml_order_id    String                  @db.VarChar(30)
  status         String                  @db.VarChar(30)
  total_amount   Decimal                 @db.Decimal(15, 2)
  currency_id    String                  @db.VarChar(10)
  buyer_nickname String?                 @db.VarChar(100)
  date_created   DateTime                @db.Timestamptz(6)
  date_closed    DateTime?               @db.Timestamptz(6)
  last_synced_at DateTime                @default(now()) @db.Timestamptz(6)
  created_at     DateTime                @default(now()) @db.Timestamptz(6)
  updated_at     DateTime                @default(now()) @db.Timestamptz(6)
  connection     mercadolibre_connection @relation(fields: [connection_id, company_id], references: [id, company_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mercadolibre_order_connection_company")

  @@unique([connection_id, ml_order_id], map: "uq_mercadolibre_order_connection_order")
  @@unique([id, company_id], map: "uq_mercadolibre_order_id_company")
  @@index([company_id, date_created], map: "idx_mercadolibre_order_company_date")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model payment {
  id                  String         @id(map: "pk_payment") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id          String         @db.Uuid
  sale_id             String         @db.Uuid
  created_by          String         @db.Uuid
  payment_date        DateTime       @default(now()) @db.Timestamptz(6)
  total               Decimal        @db.Decimal(15, 2)
  status              String         @default("COMPLETED") @db.VarChar(20)
  reference           String?        @db.VarChar(255)
  cancelled_at        DateTime?      @db.Timestamptz(6)
  cancellation_reason String?
  notes               String?
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @default(now()) @db.Timestamptz(6)
  sale                sale           @relation(fields: [sale_id, company_id], references: [id, company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payment_sale_company")
  user                user           @relation(fields: [created_by, company_id], references: [id, company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payment_user_company")
  payment_item        payment_item[]

  @@index([sale_id], map: "idx_payment_sale")
  @@index([company_id, payment_date], map: "idx_payment_company_date")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model payment_item {
  id                    String   @id(map: "pk_payment_item") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id            String   @db.Uuid
