DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
NODE_ENV=development
PORT=3001
ENABLE_SWAGGER=true
RESEND_API_KEY=
PASSWORD_RESET_FROM=PAMPA <acceso@pampa-erp.com>
# Reply-To para todos los emails transaccionales enviados desde pampa-api (hoy password reset, a futuro otras comunicaciones de seguridad).
EMAIL_REPLY_TO=pampa@pampa-erp.com

# Selects the FiscalProvider implementation: mock | arca. Required, no
# default — the app refuses to start if this isn't set exactly to one of
# these two values. Use mock for local development/demo (no ARCA_* vars
# needed); use arca for real homologación/producción.
FISCAL_PROVIDER=mock

# ARCA (WSAA) - fiscal integration, Beta scope: wsfe / Factura C only.
# ARCA_ENVIRONMENT selects the WSAA endpoint: homologation | production.
ARCA_ENVIRONMENT=homologation
ARCA_CUIT=00000000000
# Accepts a real multi-line PEM, a PEM with escaped \n, or base64 of either.
ARCA_CERTIFICATE=
ARCA_PRIVATE_KEY=
# Only needed if ARCA_PRIVATE_KEY is an encrypted PEM.
ARCA_PRIVATE_KEY_PASSPHRASE=
# Punto de venta habilitado en WSFEv1 (Administrador de Relaciones / WSASS), 1-99998.
ARCA_WSFE_PUNTO_VENTA=

# Mercado Libre integration v1 (Integraciones -> Mercado Libre).
# Leave CLIENT_ID/SECRET/REDIRECT_URI empty until the ML Developers account is
# approved — the module boots fine either way and GET /integrations/mercadolibre/status
# simply reports configured=false. Never commit real values here.
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_REDIRECT_URI=https://api.example.com/integrations/mercadolibre/callback
# Site (country) used to pick the ML authorization domain. Defaults to MLA (Argentina).
MERCADOLIBRE_SITE_ID=MLA
# AES-256-GCM key PAMPA uses to encrypt access/refresh tokens at rest before
# storing them in mercadolibre_connection. Required whenever the module is
# used (mock or real). At least 32 chars — generate with `openssl rand -hex 32`.
MERCADOLIBRE_TOKEN_ENCRYPTION_KEY=
# Serves 6-10 fake listings and 5-10 fake orders instead of calling Mercado
# Libre, so the UI/UX can be built and demoed before credentials exist. Only
# takes effect when NODE_ENV !== production — a misconfigured production
# deploy silently ignores it rather than serving mock data as real.
MERCADOLIBRE_MOCK_MODE=true

# PAMPA IA (Integraciones -> IA / /admin/ai). Leave OPENAI_API_KEY empty to
# boot with AI infrastructure present but inert — GET /ai/usage and
# POST /ai/chat both respond with AI_PROVIDER_NOT_CONFIGURED instead of
# crashing the app. Never commit a real key here.
OPENAI_API_KEY=
# Same pattern as OPENAI_API_KEY, for Carga inteligente de stock's Gemini
# provider (GeminiProvider) — extraction gracefully falls back to whichever
# of the two is configured; leaving both empty just disables the feature.
GEMINI_API_KEY=
# USD value of one PAMPA IA credit (credits = cost_usd / this value). This is
# the single lever that changes PAMPA IA's credit economy — see
# docs/pampa-ai-architecture.md.
AI_CREDIT_VALUE_USD=0.001
# Hard cap on output tokens per POST /ai/chat call — also bounds the
# worst-case cost reservation AiQuotaService holds before calling the
# provider (see docs/pampa-ai-architecture.md §Concurrencia).
AI_CHAT_MAX_OUTPUT_TOKENS=700
# PAMPA IA-only rate limits (does not affect the rest of the ERP), per company/user, per minute.
AI_RATE_LIMIT_COMPANY_PER_MINUTE=20
AI_RATE_LIMIT_USER_PER_MINUTE=6

# PAMPA IA tool-calling loop (Sprint IA-02, read-only tools). Bounds cost,
# latency and the worst-case quota reservation for a single POST /ai/chat
# call — see docs/pampa-ai-architecture.md §Loop de tool calling.
AI_MAX_TOOL_ROUNDS=5
AI_MAX_TOOL_CALLS_PER_REQUEST=10
AI_TOOL_TIMEOUT_MS=8000
# Max prior turns from the client-supplied, session-only conversation
# context that get sent back to the model (see §Conversaciones).
AI_MAX_CONVERSATION_CONTEXT_MESSAGES=10

# Product images (Catálogo -> foto de producto). Read-write token for the
# Vercel Blob store "pampa-products" (public access). Without it, image
# upload/replace/delete endpoints respond with IMAGE_STORAGE_NOT_CONFIGURED
# instead of crashing the app — the rest of the ERP works normally.
# Provision: `vercel blob create-store <name> --access public`, then copy the
# token from `vercel env pull` or the Vercel dashboard (Storage tab).
BLOB_READ_WRITE_TOKEN=
