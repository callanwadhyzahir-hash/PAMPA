  client_snapshot        Json?
  items_snapshot         Json
  totals_snapshot        Json
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  sale                   sale                     @relation(fields: [sale_id, company_id], references: [id, company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invoice_sale_company")
  invoice_fiscal_attempt invoice_fiscal_attempt[]

  @@unique([sale_id, company_id], map: "uq_invoice_sale_company")
  @@unique([id, company_id], map: "uq_invoice_id_company")
  @@unique([company_id, point_of_sale, voucher_type_code, invoice_number], map: "uq_invoice_fiscal_document")
  @@index([invoice_number], map: "idx_invoice_number")
  @@index([fiscal_status], map: "idx_invoice_fiscal_status")
}

