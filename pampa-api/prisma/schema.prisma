}

model invoice {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id             String                   @db.Uuid
  sale_id                String                   @unique @db.Uuid
  internal_number        String                   @unique @db.VarChar(50)
  document_label         String                   @default("COMPROBANTE INTERNO — NO FISCAL") @db.VarChar(100)
  invoice_number         String?                  @db.VarChar(50)
  invoice_type           String?                  @db.VarChar(10)
  cae                    String?                  @db.VarChar(50)
  cae_expiration         DateTime?                @db.Date
  issued_at              DateTime?                @db.Timestamptz(6)
  status                 String                   @default("ISSUED") @db.VarChar(20)
  fiscal_status          String                   @default("NOT_REQUESTED") @db.VarChar(20)
  fiscal_provider        String                   @default("ARCA") @db.VarChar(10)
  point_of_sale          String?                  @db.VarChar(10)
  voucher_type_code      String?                  @db.VarChar(10)
  qr_data                String?
  arca_error_code        String?                  @db.VarChar(50)
  arca_error_message     String?
  fiscal_requested_at    DateTime?                @db.Timestamptz(6)
  fiscal_approved_at     DateTime?                @db.Timestamptz(6)
