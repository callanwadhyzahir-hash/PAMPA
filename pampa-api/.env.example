DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
NODE_ENV=development
PORT=3001
ENABLE_SWAGGER=true
RESEND_API_KEY=
PASSWORD_RESET_FROM=PAMPA <acceso@pampa-erp.com>
# Reply-To para todos los emails transaccionales enviados desde pampa-api (hoy password reset, a futuro otras comunicaciones de seguridad).
EMAIL_REPLY_TO=pampa@pampa-erp.com

# Selects the FiscalProvider implementation: mock | arca. Required, no
# default — the app refuses to start if this isn't set exactly to one of
# these two values. Use mock for local development/demo (no ARCA_* vars
# needed); use arca for real homologación/producción.
FISCAL_PROVIDER=mock

# ARCA (WSAA) - fiscal integration, Beta scope: wsfe / Factura C only.
# ARCA_ENVIRONMENT selects the WSAA endpoint: homologation | production.
ARCA_ENVIRONMENT=homologation
ARCA_CUIT=00000000000
# Accepts a real multi-line PEM, a PEM with escaped \n, or base64 of either.
ARCA_CERTIFICATE=
ARCA_PRIVATE_KEY=
# Only needed if ARCA_PRIVATE_KEY is an encrypted PEM.
ARCA_PRIVATE_KEY_PASSPHRASE=
# Punto de venta habilitado en WSFEv1 (Administrador de Relaciones / WSASS), 1-99998.
ARCA_WSFE_PUNTO_VENTA=

# Mercado Libre integration v1 (Integraciones -> Mercado Libre).
# Leave CLIENT_ID/SECRET/REDIRECT_URI empty until the ML Developers account is
# approved — the module boots fine either way and GET /integrations/mercadolibre/status
# simply reports configured=false. Never commit real values here.
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_REDIRECT_URI=https://api.example.com/integrations/mercadolibre/callback
# Site (country) used to pick the ML authorization domain. Defaults to MLA (Argentina).
MERCADOLIBRE_SITE_ID=MLA
# AES-256-GCM key PAMPA uses to encrypt access/refresh tokens at rest before
# storing them in mercadolibre_connection. Required whenever the module is
# used (mock or real). At least 32 chars — generate with `openssl rand -hex 32`.
MERCADOLIBRE_TOKEN_ENCRYPTION_KEY=
# Serves 6-10 fake listings and 5-10 fake orders instead of calling Mercado
# Libre, so the UI/UX can be built and demoed before credentials exist. Only
# takes effect when NODE_ENV !== production — a misconfigured production
# deploy silently ignores it rather than serving mock data as real.
MERCADOLIBRE_MOCK_MODE=true
