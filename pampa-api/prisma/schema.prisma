generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model address {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  city_id      String   @db.Uuid
  street       String   @db.VarChar(150)
  number       String?  @db.VarChar(20)
  floor        String?  @db.VarChar(20)
  apartment    String?  @db.VarChar(20)
  neighborhood String?  @db.VarChar(100)
  zip_code     String?  @db.VarChar(20)
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  observations String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  city         city     @relation(fields: [city_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_address_city")
  branch       branch[]
  client       client[]
}

model branch {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String      @db.Uuid
  address_id String      @db.Uuid
  name       String      @db.VarChar(150)
  code       String      @db.VarChar(20)
  email      String?     @db.VarChar(255)
  phone      String?     @db.VarChar(50)
  is_main    Boolean     @default(false)
  is_active  Boolean     @default(true)
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  updated_at DateTime    @default(now()) @db.Timestamptz(6)
  address    address     @relation(fields: [address_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_branch_address")
  company    company     @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_branch_company")
  sale       sale[]
  user       user[]
  warehouse  warehouse[]

  @@unique([company_id, code], map: "uq_branch_code")
  @@unique([id, company_id], map: "uq_branch_id_company")
}

model city {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state_id    String    @db.Uuid
  name        String    @db.VarChar(150)
  postal_code String?   @db.VarChar(20)
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  address     address[]
  state       state     @relation(fields: [state_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_city_state")

  @@unique([state_id, name], map: "uq_city_state")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model client {
  id              String   @id(map: "pk_client") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id      String   @db.Uuid
  address_id      String?  @db.Uuid
  code            String   @db.VarChar(30)
  first_name      String?  @db.VarChar(100)
  last_name       String?  @db.VarChar(100)
  business_name   String?  @db.VarChar(200)
  tax_id          String?  @db.VarChar(30)
  email           String?  @db.VarChar(255)
  phone           String?  @db.VarChar(50)
  mobile          String?  @db.VarChar(50)
  is_company      Boolean  @default(false)
  credit_limit    Decimal  @default(0) @db.Decimal(15, 2)
  current_balance Decimal  @default(0) @db.Decimal(15, 2)
  notes           String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  address         address? @relation(fields: [address_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_client_address")
  company         company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_client_company")
  sale            sale[]

  @@unique([company_id, code], map: "uq_client_company_code")
  @@unique([id, company_id], map: "uq_client_id_company")
  @@index([business_name], map: "idx_client_business_name")
  @@index([company_id], map: "idx_client_company")
  @@index([tax_id], map: "idx_client_tax_id")
}

model company {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_type_id  String             @db.Uuid
  tax_condition_id String             @db.Uuid
  currency_id      String             @db.Uuid
  name             String             @db.VarChar(200)
  legal_name       String?            @db.VarChar(250)
  tax_id           String             @unique @db.VarChar(30)
  email            String?            @db.VarChar(255)
  phone            String?            @db.VarChar(50)
  website          String?            @db.VarChar(255)
  logo_url         String?
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  branch           branch[]
  client           client[]
  currency         currency           @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_company_currency")
  tax_condition    tax_condition      @relation(fields: [tax_condition_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_company_tax_condition")
  company_type     company_type       @relation(fields: [company_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_company_type")
  product          product[]
  product_category product_category[]
  role             role[]
  sale             sale[]
  user             user[]
  warehouse        warehouse[]
  security_event   security_event[]
}

model company_type {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String    @unique @db.VarChar(30)
  name        String    @db.VarChar(100)
  description String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  company     company[]
}

model country {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  iso_code   String   @unique @db.Char(2)
  name       String   @unique @db.VarChar(100)
  phone_code String?  @db.VarChar(10)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  state      state[]
}

model currency {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String    @unique @db.VarChar(3)
  name       String    @db.VarChar(100)
  symbol     String?   @db.VarChar(10)
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
